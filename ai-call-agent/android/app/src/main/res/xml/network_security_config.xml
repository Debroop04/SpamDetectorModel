<?xml version="1.0" encoding="utf-8"?>
<!-- Plain HTTP is allowed because the backend is reached by its Wi-Fi address (for example http://10.21.3.191:8000).
     Public tunnel addresses use HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
