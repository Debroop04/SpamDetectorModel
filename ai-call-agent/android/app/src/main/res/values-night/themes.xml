<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CallShield" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.CallShield.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.CallShield</item>
    </style>
</resources>
